<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Pondhawk.Sample.Api</RootNamespace>
    <AssemblyName>Pondhawk.Sample.Api</AssemblyName>
    <!-- Reference sample: demonstrates the canonical vertical-slice pattern AI copies. Not packaged. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Ulid" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ship the base config with the app; environment.json / mission.json are provided at deploy time. -->
    <Content Update="configuration.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Pondhawk.Core\Pondhawk.Core.csproj" />
    <ProjectReference Include="..\..\src\Pondhawk.Api\Pondhawk.Api.csproj" />
    <ProjectReference Include="..\..\src\Pondhawk.Persistence\Pondhawk.Persistence.csproj" />
  </ItemGroup>

</Project>
